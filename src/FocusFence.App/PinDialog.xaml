<Window x:Class="FocusFence.App.PinDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FocusFence PIN" Width="430" SizeToContent="Height" MinHeight="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F6F2">
 <StackPanel Margin="28">
  <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock x:Name="Hint" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <PasswordBox x:Name="Pin" MaxLength="12" Padding="10" AutomationProperties.Name="PIN"/>
  <PasswordBox x:Name="ConfirmPin" MaxLength="12" Padding="10" Margin="0,12,0,0" AutomationProperties.Name="Confirm new PIN"/>
  <TextBlock x:Name="Error" TextWrapping="Wrap" Margin="0,12" Foreground="#9B2525"/>
  <WrapPanel><Button x:Name="Submit" Content="Continue" Click="SubmitPin" IsDefault="True"/><Button Content="Cancel" IsCancel="True"/></WrapPanel>
 </StackPanel>
</Window>
