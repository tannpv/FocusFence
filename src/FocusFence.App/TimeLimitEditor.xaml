<UserControl x:Class="FocusFence.App.TimeLimitEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FocusFence.App">
 <UserControl.Resources><local:ExecutableIconConverter x:Key="ExecutableIcon"/></UserControl.Resources>
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock Text="Add or edit daily limit" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <DockPanel Margin="0,0,0,8">
    <TextBlock Text="Select app:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#62736A"/>
    <ComboBox x:Name="AppPicker" DisplayMemberPath="Name" SelectionChanged="OnAppPicked" Padding="6" AutomationProperties.Name="Available applications select list"/>
   </DockPanel>
   <WrapPanel Margin="0,0,0,6">
    <StackPanel Margin="0,0,8,0"><TextBlock Text="App name" FontSize="11"/><TextBox x:Name="LimitName" Width="140" AutomationProperties.Name="App limit name"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="Executable path" FontSize="11"/><TextBox x:Name="LimitPath" Width="220" AutomationProperties.Name="App executable path"/></StackPanel>
    <Button Content="Browse…" Click="BrowseExecutable" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="Daily limit (minutes)" FontSize="11"/><TextBox x:Name="LimitMinutes" Width="80" AutomationProperties.Name="Daily limit minutes"/></StackPanel>
    <CheckBox x:Name="LimitEnabled" Content="Enabled" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,8,6" AutomationProperties.Name="Limit enabled checkbox"/>
    <Button x:Name="SaveLimitButton" Content="Save limit" Click="SaveLimit" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    <Button Content="Clear" Click="ClearForm" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Child &amp; game daily time limits" FontSize="22" FontWeight="SemiBold" Margin="0,4"/>
    <TextBlock Text="Limits active foreground screen time. Once a daily limit runs out, the app is automatically closed and blocked until midnight. Parents can grant bonus time with their PIN." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#62736A"/>
    <ListBox x:Name="LimitsList" Margin="0,4" MinHeight="200" MaxHeight="340" SelectionChanged="SelectLimit">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <DockPanel Margin="6">
        <Image Source="{Binding Limit.Path, Converter={StaticResource ExecutableIcon}}" Width="24" Height="24" Margin="0,0,12,0"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Margin="0,0,12,0" VerticalAlignment="Center"/>
         <Button Content="{Binding ToggleText}" Tag="{Binding Limit.Path}" Click="ToggleLimit" Margin="0,0,4,0"/>
         <Button Content="+15m" Tag="{Binding Limit.Path}" Click="Add15Minutes" Margin="0,0,4,0"/>
         <Button Content="+30m" Tag="{Binding Limit.Path}" Click="Add30Minutes" Margin="0,0,4,0"/>
         <Button Content="Delete" Tag="{Binding Limit.Path}" Click="DeleteLimit"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
         <TextBlock Text="{Binding Limit.Name}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding UsageSummary}" FontSize="11" Foreground="#62736A"/>
        </StackPanel>
       </DockPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>